# Rosé Pine for matplotlib. Edit template.mplstyle, then regenerate the styles:
# rose-pine-bloom -t template.mplstyle -o src/poikilos/styles -f hex-ns
# All rc keys and defaults: https://matplotlib.org/stable/users/explain/customizing.html#the-default-matplotlibrc-file

patch.edgecolor: "#e0def4"

boxplot.flierprops.color: "#e0def4"
boxplot.flierprops.markeredgecolor: "#e0def4"
boxplot.boxprops.color: "#e0def4"
boxplot.whiskerprops.color: "#e0def4"
boxplot.capprops.color: "#e0def4"
boxplot.medianprops.color: "#eb6f92"
boxplot.meanprops.color: "#9ccfd8"
boxplot.meanprops.markerfacecolor: "#9ccfd8"
boxplot.meanprops.markeredgecolor: "#9ccfd8"

font.family: sans-serif
font.sans-serif: Anthropic Sans Text, Google Sans Flex, Arimo, Arial, DejaVu Sans
text.color: "#e0def4"

axes.facecolor: "#191724"
axes.edgecolor: "#6e6a86"
axes.titlecolor: "#e0def4"
axes.labelcolor: "#e0def4"
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['eb6f92', 'f6c177', '31748f', '9ccfd8', 'c4a7e7', 'ebbcba'])

xtick.color: "#908caa"
xtick.labelcolor: "#e0def4"
xtick.direction: in
ytick.color: "#908caa"
ytick.labelcolor: "#e0def4"
ytick.direction: in

grid.color: "#26233a"

legend.facecolor: "#191724"
legend.edgecolor: "#6e6a86"
legend.labelcolor: "#e0def4"

figure.dpi: 300
figure.facecolor: "#191724"
figure.edgecolor: "#191724"
figure.constrained_layout.use: True

savefig.facecolor: "#191724"
savefig.edgecolor: "#191724"

svg.fonttype: none
