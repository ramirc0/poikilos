# Rosé Pine for matplotlib. Edit template.mplstyle, then regenerate the styles:
# rose-pine-bloom -t template.mplstyle -o src/poikilos/styles -f hex-ns
# All rc keys and defaults: https://matplotlib.org/stable/users/explain/customizing.html#the-default-matplotlibrc-file

patch.edgecolor: "#575279"

boxplot.flierprops.color: "#575279"
boxplot.flierprops.markeredgecolor: "#575279"
boxplot.boxprops.color: "#575279"
boxplot.whiskerprops.color: "#575279"
boxplot.capprops.color: "#575279"
boxplot.medianprops.color: "#b4637a"
boxplot.meanprops.color: "#56949f"
boxplot.meanprops.markerfacecolor: "#56949f"
boxplot.meanprops.markeredgecolor: "#56949f"

font.family: sans-serif
font.sans-serif: Anthropic Sans Text, Google Sans Flex, Arimo, Arial, DejaVu Sans
text.color: "#575279"

axes.facecolor: "#faf4ed"
axes.edgecolor: "#9893a5"
axes.titlecolor: "#575279"
axes.labelcolor: "#575279"
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['b4637a', 'ea9d34', '286983', '56949f', '907aa9', 'd7827e'])

xtick.color: "#797593"
xtick.labelcolor: "#575279"
xtick.direction: in
ytick.color: "#797593"
ytick.labelcolor: "#575279"
ytick.direction: in

grid.color: "#f2e9e1"

legend.facecolor: "#faf4ed"
legend.edgecolor: "#9893a5"
legend.labelcolor: "#575279"

figure.dpi: 300
figure.facecolor: "#faf4ed"
figure.edgecolor: "#faf4ed"
figure.constrained_layout.use: True

savefig.facecolor: "#faf4ed"
savefig.edgecolor: "#faf4ed"

svg.fonttype: none
