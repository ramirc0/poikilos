# Illustrator artwork at 1:1: Helvetica Neue, thin spines with inward ticks.
# Pair with despine(ax, offset=7.5), 1.5 times the major tick.

font.family: sans-serif
font.sans-serif: Helvetica Neue, Helvetica, Nimbus Sans, Arial, DejaVu Sans
font.size: 10
mathtext.fontset: custom
mathtext.rm: sans
mathtext.it: sans:italic
mathtext.bf: sans:bold
mathtext.sf: sans

figure.figsize: 2.57, 2.83
figure.titlesize: 14
figure.titleweight: medium
figure.labelsize: 12

axes.linewidth: 0.75
axes.spines.top: False
axes.spines.right: False
axes.labelsize: 10
axes.labelpad: 2.8
axes.titlesize: 12
axes.titleweight: medium
axes.titlepad: 8.4
axes.formatter.use_mathtext: True

xtick.direction: in
xtick.labelsize: 8
xtick.major.size: 5
xtick.minor.size: 3
xtick.major.width: 0.75
xtick.minor.width: 0.75
xtick.major.pad: 2.03
xtick.minor.pad: 2.03
ytick.direction: in
ytick.labelsize: 8
ytick.major.size: 5
ytick.minor.size: 3
ytick.major.width: 0.75
ytick.minor.width: 0.75
ytick.major.pad: 2
ytick.minor.pad: 2

lines.linewidth: 0.5
lines.solid_capstyle: round
lines.markersize: 2
lines.markeredgewidth: 0.25
lines.scale_dashes: False
lines.dashed_pattern: 2, 1

patch.linewidth: 0.75
grid.linewidth: 0.25

legend.frameon: False

boxplot.patchartist: True
boxplot.showfliers: False
boxplot.boxprops.linewidth: 0
boxplot.medianprops.linewidth: 1.5
boxplot.whiskerprops.linewidth: 0.5
boxplot.capprops.linewidth: 0.5

errorbar.capsize: 2
errorbar.capthick: 0.5
